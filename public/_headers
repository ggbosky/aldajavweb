# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).

# HLS playlists: Safari and iPhones play them natively only with this type.
/video/:slug/index.m3u8
  Content-Type: application/vnd.apple.mpegurl
  Cache-Control: public, max-age=3600

# Video segments, thumbnails and Next's hashed bundles never change in place.
/video/*
  Cache-Control: public, max-age=31536000, immutable
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
